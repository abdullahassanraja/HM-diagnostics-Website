APP_NAME=HM Diagnostics AI Receptionist
ENVIRONMENT=development
# Demo mode accepts fictional details only and stores requests in memory.
DEMO_MODE=true
DEMO_DATA_ENABLED=true
APPOINTMENT_STORAGE=memory

GEMINI_API_KEY=
GEMINI_MODEL=
# Enable only after checking Gemini audience, region and data-use eligibility.
GEMINI_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=
GROQ_ENABLED=true
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=1
LLM_CIRCUIT_FAILURES=2
LLM_CIRCUIT_SECONDS=60

GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Appointments
GOOGLE_SERVICE_ACCOUNT_JSON=

ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:4173,http://localhost:4173
PUBLIC_BASE_URL=
KEEP_ALIVE_ENABLED=false
KEEP_ALIVE_INTERVAL_SECONDS=720
SESSION_TTL_MINUTES=30
MAX_SESSIONS=1000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=8192
TIMEZONE=Asia/Karachi
KNOWLEDGE_FILE=data/clinic_info.json
# Enforce the clinic's own retention policy for Sheets records; this applies to demo memory only.
DEMO_RETENTION_MINUTES=30
